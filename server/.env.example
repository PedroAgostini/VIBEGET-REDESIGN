# Copie para .env e ajuste. Nunca versione o .env.

# OBRIGATÓRIO declarar. Sem NODE_ENV o app aplica regras de PRODUÇÃO (exige DATABASE_URL, sem simulação de
# pagamento, sem segredos de dev). Segredos padrão e /payments/:id/simulate só existem com development|test.
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# IP do cliente para rate limit/audit. Valores:
#   false (padrão)  -> ignora X-Forwarded-For (req.ip = conexão). Atrás de proxy, TODOS dividem o mesmo balde de rate limit!
#   1, 2...         -> confia nos N proxies mais próximos (ex.: 1 = um load balancer que sobrescreve X-Forwarded-For)
#   10.0.0.0/8,...  -> confia só nesses IPs/CIDRs de proxy (recomendado)
#   true            -> confia em qualquer proxy (só se o proxy SOBRESCREVE o header; senão o cliente forja o IP)
TRUST_PROXY=false

# Vazio = PGlite (Postgres embutido) em PGLITE_DATA_DIR. Em produção é obrigatório.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# Aplica migrações no boot quando usa PGlite
AUTO_MIGRATE=true

# Em produção: >= 32 caracteres aleatórios (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh concorrente (duas abas): requisição que chegou antes da rotação recebe 409 REFRESH_RACE em vez de revogar a família
REFRESH_REUSE_GRACE_SECONDS=15
# Cookie de refresh com Secure (navegadores aceitam em http://localhost). Em produção precisa ser true.
COOKIE_SECURE=true

# Origens permitidas (CORS + checagem de Origin/CSRF), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base dos links enviados por e-mail (verificação / reset)
APP_URL=http://localhost:5173
# Hosts permitidos em imageUrl https:// de produtos. Vazio: dev/test aceita qualquer https; produção só caminhos /relativos
IMAGE_HOSTS=api.vibeget.net

# D3: VALORES INICIAIS das configurações (tabela settings, gravados pelo db:seed).
# Depois disso quem manda é o ADMIN em PATCH /admin/settings; mudar aqui não altera o que já está no banco.
WELCOME_BONUS_CENTS=0
REFERRAL_BONUS_CENTS=0
# D1: corte de Gets antes do fim (s) e margem de pagamento após o corte (s; <= corte)
GET_CUTOFF_SECONDS=60
PAYMENT_GRACE_SECONDS=40
DEFAULT_CASHBACK_PERCENT=40
# D6: saque do saldo em R$ (valores iniciais; ADMIN edita em /admin/settings/withdrawals)
WITHDRAW_MIN_CENTS=1000
WITHDRAW_DAILY_MAX_CENTS=500000
# D11: compra avulsa (valores iniciais; ADMIN edita em /admin/settings/getcoin). GetCoin em centavos (100 = 1 GetCoin)
GETCOIN_UNIT_PRICE_CENTS=100
GETCOIN_CUSTOM_MIN_CENTS=1000
GETCOIN_CUSTOM_MAX_CENTS=100000
GETCOIN_CUSTOM_ENABLED=true
# D12: marketplace (valores iniciais; ADMIN edita em /admin/settings/market)
MARKET_FEE_PERCENT=10
MARKET_MIN_UNIT_PRICE_CENTS=10
MARKET_MAX_UNIT_PRICE_CENTS=1000
MARKET_MIN_LISTING_CENTS=1000
MARKET_ENABLED=true
TERMS_VERSION=2026-09

# Pagamentos (provedor MOCK). Em produção: >= 32 caracteres.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TTL_MINUTES=30
# Intervalo dos jobs (ativar Vibes agendadas, expirar pagamentos, encerrar Vibes). 0 desliga.
JOBS_INTERVAL_MS=60000

# D5: upload de imagens do admin (jpeg/png/webp). Pasta gitignored, servida em /uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5000000

# Seed: admin inicial (senha >= 10 caracteres, não comum). Sem isso o seed não cria admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
